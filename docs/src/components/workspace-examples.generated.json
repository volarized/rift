    {
      "path": "README.md",
      "language": "markdown",
      "excerpt": false,
      "code": "# Example project\n\nA Rust project that reads workspace configuration from `rift.toml`.\n\n- `src/main.rs` starts the application.\n- `src/config.rs` loads the workspace configuration.\n- `src/error.rs` defines the error type returned by the loader.\n\nRift reads the project structure, source, and documentation to help\nan agent find the code relevant to its task.\n"
    },
    {
      "path": "rift.toml",
      "language": "toml",
      "excerpt": false,
      "code": "[search.vector]\ndisabled = true\n\n[dependencies]\nresolution = \"static\"\n\n[global]\nenabled = false\n"
    },
    {
      "path": "src/config.rs",
      "language": "rust",
      "excerpt": false,
      "code": "use std::path::Path;\n\nuse crate::error::ConfigError;\n\n/// Workspace configuration read from `rift.toml`.\npub struct Config {\n    pub root: std::path::PathBuf,\n}\n\n/// Loads the workspace configuration from `rift.toml`.\npub fn load_config(path: &Path) -> Result<Config, ConfigError> {\n    let text = std::fs::read_to_string(path)?;\n    parse_config(path, &text)\n}\n\n/// Loads the configuration at the default path.\npub fn load_default_config() -> Result<Config, ConfigError> {\n    load_config(Path::new(\"rift.toml\"))\n}\n\nfn parse_config(path: &Path, text: &str) -> Result<Config, ConfigError> {\n    if text.trim().is_empty() {\n        return Err(\"empty workspace configuration\".into());\n    }\n    let root = path\n        .parent()\n        .filter(|parent| !parent.as_os_str().is_empty())\n        .unwrap_or_else(|| Path::new(\".\"));\n    Ok(Config { root: root.into() })\n}\n"
    },
    {
      "path": "src/error.rs",
      "language": "rust",
      "excerpt": false,
      "code": "/// An error encountered while reading or parsing configuration.\npub type ConfigError = Box<dyn std::error::Error + Send + Sync>;\n"
    },
    {
      "path": "src/lib.rs",
      "language": "rust",
      "excerpt": false,
      "code": "pub mod config;\npub mod error;\n"
    },
    {
      "path": "src/main.rs",
      "language": "rust",
      "excerpt": false,
      "code": "use example_project::{config, error::ConfigError};\n\nfn main() -> Result<(), ConfigError> {\n    let config = config::load_default_config()?;\n    let runtime = tokio::runtime::Runtime::new()?;\n    runtime.block_on(print_root(config));\n    Ok(())\n}\n\nasync fn print_root(config: config::Config) {\n    println!(\"Workspace root: {}\", config.root.display());\n}\n"
    }
